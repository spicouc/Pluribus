# Pluribus (Brain v2) - Configuration
# Copy this file to .env and edit it

# Ollama (required for embeddings and consolidation)
BRAIN_OLLAMA_BASE_URL=http://localhost:11434
BRAIN_OLLAMA_MODEL=nomic-embed-text-v2-moe:latest
BRAIN_CONSOLIDATION_MODEL=llama3.2:3b

# Database
BRAIN_DB_PATH=/opt/brain/data/brain.db

# API
BRAIN_API_PORT=8790
BRAIN_EMBED_DIM=768
BRAIN_MAX_CHUNK_SIZE=500
BRAIN_CHUNK_OVERLAP=50

# Optional: Notion (leave empty if not used)
BRAIN_NOTION_API_KEY=*** Not used in MCP-only setup

# Optional: contradiction webhook URL
BRAIN_CONTRADICTION_WEBHOOK=
