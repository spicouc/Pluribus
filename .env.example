# Pluribus configuration
# Copy to /opt/pluribus/.env and edit as needed.

# Database / API
PLURIBUS_DB_PATH=/opt/pluribus/data/pluribus.db
PLURIBUS_API_PORT=8790

# Ollama embeddings
PLURIBUS_OLLAMA_BASE_URL=http://localhost:11434
PLURIBUS_OLLAMA_MODEL=nomic-embed-text-v2-moe:latest
PLURIBUS_EMBED_DIM=768

# Chunking
PLURIBUS_MAX_CHUNK_SIZE=500
PLURIBUS_CHUNK_OVERLAP=50

# Rate limiting
PLURIBUS_RATE_LIMIT=100
PLURIBUS_RATE_LIMIT_WINDOW=60

# Consolidation worker
PLURIBUS_CONSOLIDATION_MODEL=qwen3.5-2b:latest
PLURIBUS_CONSOLIDATION_FALLBACK_MODEL=hf.co/bartowski/gemma-2-2b-it-abliterated-GGUF:Q4_K_M
PLURIBUS_WORKER_BATCH_SIZE=10
PLURIBUS_SEMANTIC_THRESHOLD=0.55

# Webhooks
# false: only globally routable destinations. Set true explicitly for private
# networks/Tailscale; loopback, link-local, multicast and reserved stay blocked.
PLURIBUS_WEBHOOK_ALLOW_PRIVATE=false

# Optional Notion integration
PLURIBUS_NOTION_API_KEY=
PLURIBUS_NOTION_API_VERSION=2022-06-28
